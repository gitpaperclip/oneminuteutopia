# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Postgres Database
# These are automatically set by Vercel when you add Postgres storage
# You only need to set them manually for local development
POSTGRES_URL=postgres://user:password@host:5432/dbname
POSTGRES_PRISMA_URL=postgres://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NO_SSL=postgres://user:password@host:5432/dbname
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/dbname
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=dbname

# Vercel Blob Storage
# These are automatically set by Vercel when you add Blob storage
# You only need to set them manually for local development
BLOB_READ_WRITE_TOKEN=vercel_blob_token_here

# Authentication
# For organizer/coordinator access - set your own secure passphrase
ORGANIZER_PASSPHRASE=your_secure_passphrase_here

# Session secret for cookie signing
SESSION_SECRET=your_random_32_char_string_here

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NODE_ENV=production
