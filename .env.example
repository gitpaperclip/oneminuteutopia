# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# SpacetimeDB Configuration (if using SpacetimeDB)
SPACETIMEDB_URI=ws://localhost:3000
SPACETIMEDB_MODULE_NAME=one_minute_utopia

# Object Storage Configuration
# For production, use S3, R2, or similar
STORAGE_BUCKET=local-uploads
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Authentication
# For hackathon demo: shared organizer passphrase
ORGANIZER_PASSPHRASE=your_secure_passphrase_here
SESSION_SECRET=your_session_secret_min_32_chars

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
