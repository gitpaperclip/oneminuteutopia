# Supabase: all three values must belong to the same project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Copy the transaction pooler connection string from the Supabase dashboard.
# URL-encode reserved characters in the database password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require

# Vertex AI (recommended for production): uses Google Cloud project credits
# Set GOOGLE_SERVICE_ACCOUNT_JSON to the full service account JSON (paste the entire JSON object as a string)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS to a path to the service account JSON file (for local development)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GOOGLE_CLOUD_PROJECT=project-0e7457ec-0481-4abd-b67
GOOGLE_CLOUD_LOCATION=global

# Legacy Gemini Developer API (optional fallback): server-only API key
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional; change this to a model available to your Vertex AI project or Gemini API
GEMINI_MODEL=gemini-3.8-flash

# Apply migrations in filename order under supabase/migrations/, including
# 202609190004_mock_government_submission.sql,
# 202609190005_mock_agency.sql, and
# 202609190006_reports_realtime.sql for the demo worker.
# Create the public-read Supabase Storage bucket: report-photos.
# Store actual credentials in .env.local locally and your host's secret settings.

# Optional local worker (`npm run worker`). Same Supabase project as the app.
# MOCK_GOVERNMENT_URL=https://mock-government-page-without-api.vercel.app/
# MOCK_TRANSPORTATION_URL=https://mock-second-gov-site-transportation.vercel.app/
# MOCK_GOVERNMENT_HEADLESS=false
# MOCK_GOVERNMENT_CLICK_SUBMIT=true

