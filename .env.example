# ========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ========================================
# Get these from your Supabase project dashboard at https://supabase.com/dashboard
# Project: 1minuteutopia (obvqhywolewuipftfgd, us-west-2)

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://obvqhywolewuipftfgd.supabase.co

# Supabase Anonymous/Public Key (safe to expose in browser)
# Get from: Project Settings → API → Project API keys → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SECRET - server-side only, never expose to browser)
# Get from: Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Database Connection String (Postgres with SSL required)
# Get from: Project Settings → Database → Connection string → URI
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# Replace [YOUR-PASSWORD] with your actual database password
# IMPORTANT: Use "postgresql://" (not "postgres://") and include "?sslmode=require"
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.obvqhywolewuipftfgd.supabase.co:5432/postgres?sslmode=require

# ========================================
# AI CONFIGURATION (REQUIRED)
# ========================================

# Google Gemini API Key for image analysis
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# AUTHENTICATION (REQUIRED)
# ========================================

# Coordinator/Organizer passphrase for accessing the inbox
# Set this to your own secure passphrase
ORGANIZER_PASSPHRASE=your_secure_passphrase_here

# Session secret for cookie signing (must be at least 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your_random_32_char_string_here

# ========================================
# APPLICATION CONFIGURATION
# ========================================

# Your application's public URL (required for redirects and session cookies)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Node environment (production, development, test)
NODE_ENV=production

# ========================================
# DEPRECATED VERCEL VARIABLES
# ========================================
# After migrating to Supabase, REMOVE these from your Vercel environment:
# 
# - POSTGRES_URL
# - POSTGRES_PRISMA_URL
# - POSTGRES_URL_NO_SSL
# - POSTGRES_URL_NON_POOLING
# - POSTGRES_USER
# - POSTGRES_HOST
# - POSTGRES_PASSWORD
# - POSTGRES_DATABASE
# - BLOB_READ_WRITE_TOKEN
# - BLOB_STORE_ID
# - BLOB_READ_WRITE_TOKEN_STORE_ID
#
# The application will prefer Supabase variables (DATABASE_URL, NEXT_PUBLIC_SUPABASE_URL)
# over legacy Vercel variables if both are present.
